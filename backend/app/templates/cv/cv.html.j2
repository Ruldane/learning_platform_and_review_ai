{#- CV template (D120). Populate it from the template designer's spec and escape all content.
    Use text-only markup without scripts or images. Render column 1 before column 2 so a parser
    reads them in order. Keep contact details in the page body. -#}
{% macro identity() %}
<section class="identity">
<h1>{{ content.name }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{% if content.contact %}
<ul class="contact">
{% for value in content.contact %}<li>{{ value }}</li>
{% endfor %}
</ul>
{% endif %}
{% if header_links %}
<ul class="profile-links">
{% for link, href in header_links %}
<li>{% if href %}<a href="{{ href }}">{{ link.label }} — {{ link.url }}</a>{% else %}{{ link.label }} — {{ link.url }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</section>
{% endmacro %}
{% macro section(block, skill_columns) %}
<section class="cv-section section-{{ block.key }}">
<h2>{{ block.title }}</h2>
{% for entry in block.entries %}
<div class="entry">
<div class="entry-head">
{% if entry.heading %}<h3>{{ entry.heading }}</h3>{% endif %}
{% if entry.dates %}<span class="dates">{{ entry.dates }}</span>{% endif %}
</div>
{% if entry.subheading %}<p class="sub">{{ entry.subheading }}</p>{% endif %}
{% if entry.lines %}
<ul>
{% for line in entry.lines %}<li class="line">{{ line.text }}</li>
{% endfor %}
</ul>
{% endif %}
</div>
{% endfor %}
{% if block.items %}
{% set columns = [skill_columns, block.items | length] | min if block.key == 'skills' else 1 %}
<ul class="items{% if columns > 1 %} skills-columns-{{ columns }}{% endif %}">
{% for item in block.items %}<li class="line">{{ item.text }}</li>
{% endfor %}
</ul>
{% endif %}
</section>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<title>CV</title>
<link rel="stylesheet" href="base.css">
<link rel="stylesheet" href="cv.css">
</head>
<body class="{{ classes }}">
{% if band %}
<div class="band">
{{ identity() }}
</div>
{% endif %}
<div class="cols">
{% for column in columns %}
{% set skill_columns_here = skill_columns[loop.index0] %}
<div class="col col-{{ loop.index }}">
{% for block in column %}
{% if block == "identity" %}
{{ identity() }}
{% else %}
{{ section(block, skill_columns_here) }}
{% endif %}
{% endfor %}
</div>
{% endfor %}
</div>
</body>
</html>
