# .env.example : seules les clés sont à remplir (une seule suffit, voir le README)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
# optionnel
BRAVE_API_KEY=
# local (un seul utilisateur, sans connexion) ou google (un compte Google par personne)
AUTH_MODE=local
# requis seulement si AUTH_MODE=google (console Google Cloud, client « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Requis si AUTH_MODE=google : le back refuse de démarrer si la liste est vide.
# Adresses autorisées, séparées par des virgules (minuscules et espaces sans importance) ;
# `*` laisse entrer tous les comptes Google ; sinon seuls ceux de la liste entrent.
# Modifiée, elle prend effet au redémarrage du back.
# ALLOWED_EMAILS=camille.exemple@example.org,dominique.exemple@example.org
# Mode Google : adresse de retour enregistrée dans la console Google, et adresse du front où
# l'on revient après la connexion (défauts : ceux de BACKEND_PORT et FRONTEND_PORT)
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# Échéance totale d'un appel à un modèle, en secondes (une réponse en flux comprise)
# LLM_CALL_DEADLINE_S=600
# Repli Gotenberg du lecteur web (pages rendues en JavaScript) ; false le coupe
# WEB_RENDER_FALLBACK=true
# Ports publiés sur la machine (127.0.0.1), à changer s'ils sont déjà pris
# FRONTEND_PORT=5173
# BACKEND_PORT=8000
# QDRANT_PORT=6333
# Origine(s) du front autorisée(s) par le back, séparées par des virgules ; défaut : suit
# FRONTEND_PORT. localhost et 127.0.0.1 sont acceptés tous les deux pour le même port.
# CORS_ORIGIN=http://localhost:5173
