# .env.example : seules les clés sont à remplir
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
# optionnel
BRAVE_API_KEY=
# local ou google
AUTH_MODE=local
# requis seulement si AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# ALLOWED_EMAILS=
# Repli Gotenberg du lecteur web (pages rendues en JavaScript) ; false le coupe
# WEB_RENDER_FALLBACK=true
# Ports publiés sur la machine (127.0.0.1), à changer s'ils sont déjà pris
# FRONTEND_PORT=5173
# BACKEND_PORT=8000
# QDRANT_PORT=6333
# Origine(s) du front autorisée(s) par le back, séparées par des virgules ; défaut : suit
# FRONTEND_PORT. localhost et 127.0.0.1 sont acceptés tous les deux pour le même port.
# CORS_ORIGIN=http://localhost:5173
