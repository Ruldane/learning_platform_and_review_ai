{
  "components": {
    "schemas": {
      "ApiKeyIn": {
        "properties": {
          "key": {
            "format": "password",
            "title": "Key",
            "type": "string",
            "writeOnly": true
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "key"
        ],
        "title": "ApiKeyIn",
        "type": "object"
      },
      "ApiKeyOut": {
        "description": "Une clé, jamais en clair : seuls les 4 derniers caractères sont exposés.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "last_test_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Test Ok"
          },
          "last_tested_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Tested At"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "readable": {
            "title": "Readable",
            "type": "boolean"
          },
          "source": {
            "anyOf": [
              {
                "enum": [
                  "ui",
                  "env"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "provider",
          "label",
          "source",
          "last4",
          "readable",
          "last_tested_at",
          "last_test_ok"
        ],
        "title": "ApiKeyOut",
        "type": "object"
      },
      "Availability-Input": {
        "properties": {
          "weekday_minutes": {
            "default": 120,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekday Minutes",
            "type": "integer"
          },
          "weekend_block_max_minutes": {
            "default": 240,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekend Block Max Minutes",
            "type": "integer"
          },
          "weekend_block_min_minutes": {
            "default": 180,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekend Block Min Minutes",
            "type": "integer"
          }
        },
        "title": "Availability",
        "type": "object"
      },
      "Availability-Output": {
        "properties": {
          "weekday_minutes": {
            "default": 120,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekday Minutes",
            "type": "integer"
          },
          "weekend_block_max_minutes": {
            "default": 240,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekend Block Max Minutes",
            "type": "integer"
          },
          "weekend_block_min_minutes": {
            "default": 180,
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Weekend Block Min Minutes",
            "type": "integer"
          },
          "weekly_budget_minutes": {
            "description": "Budget hebdomadaire : cinq jours de semaine plus un bloc de week-end (borne haute).",
            "readOnly": true,
            "title": "Weekly Budget Minutes",
            "type": "integer"
          }
        },
        "required": [
          "weekly_budget_minutes"
        ],
        "title": "Availability",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthReport": {
        "description": "`down` si la base échoue, `degraded` si un autre contrôle échoue, sinon `ok`.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "HealthStatus": {
        "description": "État d'un service. `detail` est en français et ne contient jamais de secret.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "detail"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "KeyTestResult": {
        "description": "Résultat d'un test de clé : `message` est en français et ne contient jamais la clé.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "message"
        ],
        "title": "KeyTestResult",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "auth_mode": {
            "title": "Auth Mode",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "auth_mode"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ModelChoice": {
        "description": "Fournisseur et identifiant de modèle retenus pour un niveau ou un agent.",
        "properties": {
          "model": {
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelChoice",
        "type": "object"
      },
      "ModelsOut": {
        "properties": {
          "presets": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/components/schemas/ModelChoice"
              },
              "propertyNames": {
                "enum": [
                  "rapide",
                  "standard",
                  "fort",
                  "vision"
                ]
              },
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "all_haiku",
                "haiku_sonnet_strong",
                "all_glm",
                "all_openai"
              ]
            },
            "title": "Presets",
            "type": "object"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderModels"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers",
          "presets"
        ],
        "title": "ModelsOut",
        "type": "object"
      },
      "ProviderModels": {
        "properties": {
          "has_key": {
            "title": "Has Key",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "models": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "has_key",
          "models"
        ],
        "title": "ProviderModels",
        "type": "object"
      },
      "SettingsOut": {
        "description": "Réglages renvoyés par l'API : ajoute les valeurs calculées, jamais stockées.",
        "properties": {
          "agent_overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelChoice"
            },
            "title": "Agent Overrides",
            "type": "object"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability-Output"
          },
          "brief_time": {
            "default": "07:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Brief Time",
            "type": "string"
          },
          "debate_rounds": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Debate Rounds",
            "type": "integer"
          },
          "excluded_domains": {
            "items": {
              "type": "string"
            },
            "title": "Excluded Domains",
            "type": "array"
          },
          "lesson_language": {
            "default": "fr",
            "title": "Lesson Language",
            "type": "string"
          },
          "preferred_domains": {
            "items": {
              "type": "string"
            },
            "title": "Preferred Domains",
            "type": "array"
          },
          "reminder_delays_days": {
            "items": {
              "type": "integer"
            },
            "title": "Reminder Delays Days",
            "type": "array"
          },
          "search_languages": {
            "items": {
              "type": "string"
            },
            "title": "Search Languages",
            "type": "array"
          },
          "search_provider_order": {
            "items": {
              "type": "string"
            },
            "title": "Search Provider Order",
            "type": "array"
          },
          "session_token_cap": {
            "default": 300000,
            "minimum": 10000.0,
            "title": "Session Token Cap",
            "type": "integer"
          },
          "style_guide": {
            "default": "",
            "title": "Style Guide",
            "type": "string"
          },
          "tiers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelChoice"
            },
            "propertyNames": {
              "enum": [
                "rapide",
                "standard",
                "fort",
                "vision"
              ]
            },
            "title": "Tiers",
            "type": "object"
          },
          "vision_enabled": {
            "description": "Faux si le niveau `vision` pointe vers un modèle sans vision (spec 11.2).",
            "readOnly": true,
            "title": "Vision Enabled",
            "type": "boolean"
          },
          "weekly_review": {
            "$ref": "#/components/schemas/WeeklyReview"
          }
        },
        "required": [
          "vision_enabled"
        ],
        "title": "SettingsOut",
        "type": "object"
      },
      "UserSettings": {
        "properties": {
          "agent_overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelChoice"
            },
            "title": "Agent Overrides",
            "type": "object"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability-Input"
          },
          "brief_time": {
            "default": "07:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Brief Time",
            "type": "string"
          },
          "debate_rounds": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Debate Rounds",
            "type": "integer"
          },
          "excluded_domains": {
            "items": {
              "type": "string"
            },
            "title": "Excluded Domains",
            "type": "array"
          },
          "lesson_language": {
            "default": "fr",
            "title": "Lesson Language",
            "type": "string"
          },
          "preferred_domains": {
            "items": {
              "type": "string"
            },
            "title": "Preferred Domains",
            "type": "array"
          },
          "reminder_delays_days": {
            "items": {
              "type": "integer"
            },
            "title": "Reminder Delays Days",
            "type": "array"
          },
          "search_languages": {
            "items": {
              "type": "string"
            },
            "title": "Search Languages",
            "type": "array"
          },
          "search_provider_order": {
            "items": {
              "type": "string"
            },
            "title": "Search Provider Order",
            "type": "array"
          },
          "session_token_cap": {
            "default": 300000,
            "minimum": 10000.0,
            "title": "Session Token Cap",
            "type": "integer"
          },
          "style_guide": {
            "default": "",
            "title": "Style Guide",
            "type": "string"
          },
          "tiers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelChoice"
            },
            "propertyNames": {
              "enum": [
                "rapide",
                "standard",
                "fort",
                "vision"
              ]
            },
            "title": "Tiers",
            "type": "object"
          },
          "weekly_review": {
            "$ref": "#/components/schemas/WeeklyReview"
          }
        },
        "title": "UserSettings",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeeklyReview": {
        "properties": {
          "day": {
            "default": "sunday",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ],
            "title": "Day",
            "type": "string"
          },
          "time": {
            "default": "18:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Time",
            "type": "string"
          }
        },
        "title": "WeeklyReview",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tremplin",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Toujours 200 et sans authentification : le front lit `status`.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "get_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Settings",
        "tags": [
          "settings"
        ]
      },
      "put": {
        "operationId": "replace_settings_api_v1_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replace Settings",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/api-keys": {
      "get": {
        "operationId": "list_api_keys_api_v1_settings_api_keys_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApiKeyOut"
                  },
                  "title": "Response List Api Keys Api V1 Settings Api Keys Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Api Keys",
        "tags": [
          "settings"
        ]
      },
      "post": {
        "operationId": "save_api_key_api_v1_settings_api_keys_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Api Key",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/api-keys/{provider}": {
      "delete": {
        "operationId": "delete_api_key_api_v1_settings_api_keys__provider__delete",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Api Key",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/api-keys/{provider}/test": {
      "post": {
        "operationId": "test_api_key_api_v1_settings_api_keys__provider__test_post",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyTestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Api Key",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/v1/settings/models": {
      "get": {
        "operationId": "list_models_api_v1_settings_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "settings"
        ]
      }
    }
  }
}
